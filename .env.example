# Leave this as /api — the scan API runs inside the Next.js app.
# Works on localhost and Vercel with no changes.
NEXT_PUBLIC_API_URL=/api

# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional override if Groq changes its supported vision models.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
